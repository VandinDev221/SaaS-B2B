PORT=4000
NODE_ENV=development
# Producao Render: Postgres no Neon (https://neon.tech) — ex.:
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowos?schema=public
# Producao: Neon (DATABASE_URL) + Upstash (REDIS_URL rediss://)
REDIS_URL=redis://localhost:6379

# Producao: origens permitidas separadas por virgula (obrigatorio se NODE_ENV=production)
CORS_ORIGINS=http://localhost:3000

AUTOMATION_ENABLED=true
AUTOMATION_WORKER_CONCURRENCY=5
FOLLOWUP_D1_AFTER_HOURS=24
FOLLOWUP_D1_CRON=0 * * * *
FOLLOWUP_D7_AFTER_DAYS=7
FOLLOWUP_D7_CRON=0 9 * * *
TRIAL_EXPIRY_CRON=0 6 * * *
BILLING_RECOVERY_CRON=0 10 * * *
POSTSALE_CRON=0 11 * * *

WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=flowos
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:4000/v1/integrations/whatsapp/webhook/evolution
EVOLUTION_WEBHOOK_SECRET=

# Apenas desenvolvimento (NODE_ENV!=production)
ALLOW_WHATSAPP_MOCK=false
ALLOW_PIX_MOCK=false

# Producao: use openssl rand -base64 48 para cada segredo (min. 32 caracteres)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
WEBHOOK_SIGNING_SECRET=

# IA — Ollama local (gratis, recomendado): https://ollama.com
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
# Modelos bons em PT-BR: llama3.2, qwen2.5:3b, gemma2:2b
OLLAMA_TIMEOUT_MS=120000

# Alternativas (defina AI_PROVIDER=huggingface ou openai)
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V4-Pro:novita
HF_BASE_URL=https://router.huggingface.co/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PUBLIC_WEB_URL=http://localhost:3000
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
