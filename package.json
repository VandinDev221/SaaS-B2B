{
  "name": "flowos-platform",
  "private": true,
  "version": "0.1.0",
  "description": "FLOWOS - Sistema Operacional Comercial para Pequenos Negocios",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "npm run dev -w @flowos/web",
    "dev:api": "npm run start:dev -w @flowos/api",
    "build": "npm run build -w @flowos/web && npm run build -w @flowos/api",
    "lint": "npm run lint -w @flowos/web && npm run lint -w @flowos/api",
    "test": "npm run test -w @flowos/api",
    "format": "npm run format -w @flowos/web && npm run format -w @flowos/api",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "setup:evolution": "powershell -ExecutionPolicy Bypass -File scripts/setup-evolution.ps1",
    "setup:evolution:prod": "powershell -ExecutionPolicy Bypass -File scripts/setup-evolution-prod.ps1",
    "fix:neon-migration": "powershell -ExecutionPolicy Bypass -File scripts/fix-neon-migration-conflict.ps1",
    "diagnose:inbox": "powershell -ExecutionPolicy Bypass -File scripts/diagnose-inbox.ps1",
    "sync:evolution-webhook": "powershell -ExecutionPolicy Bypass -File scripts/sync-evolution-webhook.ps1",
    "reset:evolution-schema": "powershell -ExecutionPolicy Bypass -File scripts/reset-evolution-schema.ps1",
    "setup:ollama": "powershell -ExecutionPolicy Bypass -File scripts/setup-ollama.ps1",
    "smoke": "powershell -ExecutionPolicy Bypass -File scripts/smoke-test.ps1",
    "health": "powershell -ExecutionPolicy Bypass -File scripts/health-check.ps1",
    "db:seed": "npm run prisma:seed -w @flowos/api",
    "db:migrate": "npm run prisma:deploy -w @flowos/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
